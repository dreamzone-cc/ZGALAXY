# =====================================================================
# ZGALAXY Engine & Console — environment reference
# Copy to .env (engine reads dotenv) and adjust. See docs for details.
# =====================================================================

# --- Engine (core) ---
# Super-admin API key. If unset/weak, a random key is generated and persisted
# to config/.secret_key on first boot (mode 0600). Rotate = restart with a
# new value.
SECRET_KEY=

# HTTP port the engine listens on (default 3000).
ENGINE_PORT=3000

# ZeroTier wire port (default 9994).
ZT_PORT=9994

# Runtime directory overrides (auto-detected under Docker via /app).
# CONFIG_PATH=./config
# DIST_PATH=./dist
# ZT_VAR_PATH=/var/lib/zerotier-one
# APP_PATH=.

# Explicit binary overrides (otherwise resolved in ztVar/app dirs then PATH).
# IDTOOL_PATH=
# MKMOONWORLD_PATH=

# --- Security ---
# Comma-separated list of allowed browser origins for CORS (e.g. the console's
# origin when served from a different host/port). localhost:5173 is added
# automatically outside production.
CORS_ORIGINS=

# Set 1 to store auth (users/sessions) in SQLite instead of JSON.
# Requires Node >= 22.5 or Bun. Run scripts/migrate-auth-to-sqlite.mjs first.
USE_SQLITE=

# Independent passphrase for AES-256-GCM backup encryption. If unset, the
# encryption key is derived from SECRET_KEY (weakens the separation).
BACKUP_PASSPHRASE=

# --- Web console (adapter-node build output) ---
# Console server port (default 3000 for adapter-node; host scripts use 5173).
PORT=5173
# Console host to bind (default 0.0.0.0).
HOST=0.0.0.0

# --- Web console (runtime API base URL, SvelteKit $env/dynamic/public) ---
# Empty = same origin (recommended behind a reverse proxy). Set explicitly to
# http://<engine-host>:<engine-port> when the console is on a different origin.
PUBLIC_API_URL=

# --- ZeroTier bootstrapping (used by the Docker entrypoint on first init) ---
# IP_ADDR4=
# IP_ADDR6=
